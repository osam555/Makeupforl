rules_version = '2';

// 메이크업포엘 Firebase Storage 규칙
// 배포: Firebase Console > Storage > Rules 탭에 붙여넣기
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['makeupforl77@gmail.com', 'john.wu571@gmail.com'];
    }

    // 100문100답 오디오: 읽기·업로드 모두 관리자만 (20MB 이하 mp3)
    //
    // 화면이 쓰는 주소는 전부 ?token= 이 붙은 다운로드 주소라 이 규칙과 상관없이 재생된다.
    // 공개 읽기였을 때는 토큰 없이 파일 이름(= slug)만으로 잠긴 답변 음성을 받을 수 있었다
    // (2026-11-07 확인). 이미 밖에 나간 토큰은 scripts/wed100/rotate_audio_tokens.py 로 바꾼다.
    match /wed100/audio/{file} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType == 'audio/mpeg';
    }

    // 100문100답 사진 — 어드민에서 올린 히어로/썸네일 (WebP, 10MB 이하)
    match /wed100/photo/{kind}/{file} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 100문100답 대표 이미지(사진 교체용)
    match /wed100/img/{file} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 갤러리 이미지
    // 사이트 UI 이미지 (히어로 배너·대표 사진 등)
    match /site/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 고객후기 이미지
    match /reviews/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.contentType.matches('image/.*');
    }
  }
}
