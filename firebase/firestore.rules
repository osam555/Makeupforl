rules_version = '2';

// 메이크업포엘 Firestore 보안 규칙
// 배포: Firebase Console > Firestore Database > 규칙 탭에 붙여넣기
//
// 관리자는 아래 이메일 목록으로 판별합니다. 계정을 추가하려면
// isAdmin() 의 목록과 Vercel 환경변수 NEXT_PUBLIC_ADMIN_EMAILS 를 함께 수정하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['makeupforl77@gmail.com', 'john.wu571@gmail.com'];
    }

    // 100문100답 콘텐츠: 읽기·수정 모두 관리자만 (2026-11-07 공개 읽기를 닫음)
    //
    // 잠긴 95문항의 답·자막·음성 주소가 한 문서에 들어 있어, 공개 읽기면 REST 주소 하나로
    // 유료 원고 전부를 로그인 없이 받을 수 있었다. 손님 화면은 서버(Admin SDK, 규칙 우회)가
    // 읽고 구매자는 /api/wed100/answer 로 받으므로 공개 읽기가 필요한 곳이 없다.
    // 서비스 계정 없는 로컬 개발은 권한 오류 → 시드 폴백(src/lib/wed100.ts)으로 그대로 돈다.
    match /wed100_questions/{slug} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 100문100답 사진 카탈로그: 공개 읽기, 올리기·수정은 관리자만
    match /wed100_photos/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 삭제 보관함: 관리자만 (복구용)
    match /wed100_deleted/{id} {
      allow read, write: if isAdmin();
    }

    // 조회/재생 이벤트: 누구나 생성만, 수정·삭제 금지
    match /wed100_events/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['slug', 'event', 'createdAt'])
                    && request.resource.data.event in ['view', 'play', 'complete', 'cta_click'];
      allow update, delete: if false;
    }

    // 예약: 고객이 생성, 조회·상태변경은 관리자만
    match /bookings/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'status']);
      allow update: if isAdmin();
      // 시험 샘플을 지울 길이 없었다(2026-10-30). 지우기는 관리자만.
      allow delete: if isAdmin();
    }

    // 상담 신청(100문100답 안내 채팅): 이름·전화번호가 들어 있다.
    // 접수(create)는 /api/consult-lead(Admin SDK, 규칙 우회)만 한다. bookings 처럼 클라이언트
    // create 를 열어 두면 봇이 API 의 형식 검사·숨은 칸을 건너뛰고 바로 쓸 수 있다.
    // 관리자는 /admin/leads 에서 읽고, 상태를 바꾸고, 보관 기간이 지나면 지운다.
    match /consult_leads/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // 100문100답 이용권 회원(이름·지메일·전화·기한): 관리자만.
    // site_config 는 공개 읽기라 개인정보를 거기 두면 누구나 읽는다 — 따로 뺐다.
    // 쓰기는 /api/wed100/members(Admin SDK)가 하고, 화면은 읽기만 한다.
    match /wed100_members/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 설문 단계 통계(익명 증가값): 서버만 쓰고 관리자만 읽는다
    match /survey_daily/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 이용권 회원 열람 기록: 서버(Admin SDK)만 쓰고 관리자만 읽는다
    match /wed100_usage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 후기: 공개 읽기, 수정은 관리자만
    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사이트 UI 이미지: 공개 읽기, 수정은 관리자만
    match /site_images/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 갤러리 이미지: 공개 읽기, 수정은 관리자만
    match /gallery_images/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 영상자료(유튜브): 공개 읽기, 수정은 관리자만
    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사이트 설정(채널 주소 등): 공개 읽기, 수정은 관리자만
    // 공개 문서다 — 개인정보를 두지 말 것. site_config/wed100 의 옛 members(구매자 이메일)는
    // wed100_members 로 옮기고 지웠다(scripts/wed100/move_public_members.py, 2026-11-07).
    match /site_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
