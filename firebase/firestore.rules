rules_version = '2';

// 메이크업포엘 Firestore 보안 규칙
// 배포: Firebase Console > Firestore Database > 규칙 탭에 붙여넣기
//
// 관리자는 아래 이메일 목록으로 판별합니다. 계정을 추가하려면
// isAdmin() 의 목록과 Vercel 환경변수 NEXT_PUBLIC_ADMIN_EMAILS 를 함께 수정하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['makeupforl77@gmail.com'];
    }

    // 100문100답 콘텐츠: 공개 읽기, 수정은 관리자만
    match /wed100_questions/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 조회/재생 이벤트: 누구나 생성만, 수정·삭제 금지
    match /wed100_events/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['slug', 'event', 'createdAt'])
                    && request.resource.data.event in ['view', 'play', 'complete', 'cta_click'];
      allow update, delete: if false;
    }

    // 예약: 고객이 생성, 조회·상태변경은 관리자만
    match /bookings/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'status']);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // 후기: 공개 읽기, 수정은 관리자만
    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 갤러리 이미지: 공개 읽기, 수정은 관리자만
    match /gallery_images/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
